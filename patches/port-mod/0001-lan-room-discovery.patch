diff --git a/STS2AndroidPortCompat/Patches/LanRoomDiscoveryService.cs b/STS2AndroidPortCompat/Patches/LanRoomDiscoveryService.cs
new file mode 100644
index 0000000..02e7d7d
--- /dev/null
+++ b/STS2AndroidPortCompat/Patches/LanRoomDiscoveryService.cs
@@ -0,0 +1,343 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace STS2Mobile.Patches;
+
+/// <summary>
+/// Provides LAN room discovery via UDP broadcast for Android multiplayer.
+/// Hosts periodically broadcast their room information, and clients listen
+/// for these broadcasts to discover available rooms on the local network.
+/// </summary>
+public class LanRoomDiscoveryService : IDisposable
+{
+    private const int DiscoveryPort = 33770; // One below the game port
+    private const int BroadcastIntervalMs = 2000;
+    private const int RoomTimeoutMs = 10000;
+    private const string DiscoveryMagic = "STS2LANROOM";
+    
+    private UdpClient _broadcastClient;
+    private UdpClient _listenerClient;
+    private CancellationTokenSource _cancellationSource;
+    private Task _broadcastTask;
+    private Task _listenerTask;
+    private readonly object _roomsLock = new object();
+    private readonly Dictionary<string, DiscoveredRoom> _discoveredRooms = new Dictionary<string, DiscoveredRoom>();
+    private Java.Lang.Object _multicastLock;
+
+    public class RoomInfo
+    {
+        public string HostName { get; set; }
+        public string HostIpAddress { get; set; }
+        public ushort GamePort { get; set; }
+        public int CurrentPlayers { get; set; }
+        public int MaxPlayers { get; set; }
+        public string GameMode { get; set; }
+        public long Timestamp { get; set; }
+    }
+
+    private class DiscoveredRoom
+    {
+        public RoomInfo Info { get; set; }
+        public DateTime LastSeen { get; set; }
+    }
+
+    /// <summary>
+    /// Starts broadcasting room information as a host.
+    /// </summary>
+    public void StartBroadcasting(ushort gamePort, int currentPlayers, int maxPlayers, string gameMode)
+    {
+        try
+        {
+            _cancellationSource = new CancellationTokenSource();
+            var hostName = GetDeviceName();
+            var localIp = GetPrimaryLocalIpAddress();
+
+            _broadcastTask = Task.Run(async () =>
+            {
+                try
+                {
+                    _broadcastClient = new UdpClient();
+                    _broadcastClient.EnableBroadcast = true;
+
+                    var roomInfo = new RoomInfo
+                    {
+                        HostName = hostName,
+                        HostIpAddress = localIp,
+                        GamePort = gamePort,
+                        CurrentPlayers = currentPlayers,
+                        MaxPlayers = maxPlayers,
+                        GameMode = gameMode ?? "Standard"
+                    };
+
+                    PatchHelper.Log($"LAN discovery: Broadcasting room on port {DiscoveryPort}, game port {gamePort}");
+
+                    while (!_cancellationSource.Token.IsCancellationRequested)
+                    {
+                        try
+                        {
+                            roomInfo.Timestamp = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+                            var message = SerializeRoomInfo(roomInfo);
+                            var data = Encoding.UTF8.GetBytes(message);
+
+                            // Broadcast to subnet
+                            await _broadcastClient.SendAsync(data, data.Length, 
+                                new IPEndPoint(IPAddress.Broadcast, DiscoveryPort));
+
+                            await Task.Delay(BroadcastIntervalMs, _cancellationSource.Token);
+                        }
+                        catch (OperationCanceledException)
+                        {
+                            break;
+                        }
+                        catch (Exception ex)
+                        {
+                            PatchHelper.Log($"LAN discovery broadcast error: {ex.Message}");
+                        }
+                    }
+                }
+                finally
+                {
+                    _broadcastClient?.Dispose();
+                }
+            }, _cancellationSource.Token);
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Failed to start LAN room broadcasting: {ex}");
+        }
+    }
+
+    /// <summary>
+    /// Starts listening for room broadcasts.
+    /// </summary>
+    public void StartListening()
+    {
+        try
+        {
+            AcquireMulticastLock();
+            _cancellationSource = new CancellationTokenSource();
+
+            _listenerTask = Task.Run(async () =>
+            {
+                try
+                {
+                    _listenerClient = new UdpClient();
+                    _listenerClient.ExclusiveAddressUse = false;
+                    _listenerClient.Client.SetSocketOption(SocketOptionLevel.Socket, SocketOptionName.ReuseAddress, true);
+                    _listenerClient.Client.Bind(new IPEndPoint(IPAddress.Any, DiscoveryPort));
+
+                    PatchHelper.Log($"LAN discovery: Listening for rooms on port {DiscoveryPort}");
+
+                    while (!_cancellationSource.Token.IsCancellationRequested)
+                    {
+                        try
+                        {
+                            var result = await _listenerClient.ReceiveAsync();
+                            var message = Encoding.UTF8.GetString(result.Buffer);
+                            
+                            if (TryDeserializeRoomInfo(message, out var roomInfo))
+                            {
+                                // Validate the room isn't from ourselves
+                                if (!IsLocalAddress(roomInfo.HostIpAddress))
+                                {
+                                    var roomKey = $"{roomInfo.HostIpAddress}:{roomInfo.GamePort}";
+                                    lock (_roomsLock)
+                                    {
+                                        _discoveredRooms[roomKey] = new DiscoveredRoom
+                                        {
+                                            Info = roomInfo,
+                                            LastSeen = DateTime.UtcNow
+                                        };
+                                    }
+                                }
+                            }
+
+                            // Clean up expired rooms
+                            CleanupExpiredRooms();
+                        }
+                        catch (OperationCanceledException)
+                        {
+                            break;
+                        }
+                        catch (Exception ex)
+                        {
+                            PatchHelper.Log($"LAN discovery listener error: {ex.Message}");
+                        }
+                    }
+                }
+                finally
+                {
+                    _listenerClient?.Dispose();
+                }
+            }, _cancellationSource.Token);
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Failed to start LAN room listening: {ex}");
+        }
+    }
+
+    /// <summary>
+    /// Gets the list of currently discovered rooms.
+    /// </summary>
+    public List<RoomInfo> GetDiscoveredRooms()
+    {
+        lock (_roomsLock)
+        {
+            CleanupExpiredRooms();
+            return _discoveredRooms.Values
+                .Select(r => r.Info)
+                .OrderByDescending(r => r.Timestamp)
+                .ToList();
+        }
+    }
+
+    /// <summary>
+    /// Stops broadcasting and/or listening.
+    /// </summary>
+    public void Stop()
+    {
+        _cancellationSource?.Cancel();
+        _broadcastTask?.Wait(TimeSpan.FromSeconds(1));
+        _listenerTask?.Wait(TimeSpan.FromSeconds(1));
+        ReleaseMulticastLock();
+    }
+
+    public void Dispose()
+    {
+        Stop();
+        _cancellationSource?.Dispose();
+        _broadcastClient?.Dispose();
+        _listenerClient?.Dispose();
+    }
+
+    private void CleanupExpiredRooms()
+    {
+        lock (_roomsLock)
+        {
+            var expiredTime = DateTime.UtcNow.AddMilliseconds(-RoomTimeoutMs);
+            var expiredKeys = _discoveredRooms
+                .Where(kvp => kvp.Value.LastSeen < expiredTime)
+                .Select(kvp => kvp.Key)
+                .ToList();
+
+            foreach (var key in expiredKeys)
+            {
+                _discoveredRooms.Remove(key);
+            }
+        }
+    }
+
+    private string SerializeRoomInfo(RoomInfo roomInfo)
+    {
+        var json = JsonSerializer.Serialize(roomInfo);
+        return $"{DiscoveryMagic}|{json}";
+    }
+
+    private bool TryDeserializeRoomInfo(string message, out RoomInfo roomInfo)
+    {
+        roomInfo = null;
+        try
+        {
+            if (!message.StartsWith(DiscoveryMagic + "|"))
+                return false;
+
+            var json = message.Substring(DiscoveryMagic.Length + 1);
+            roomInfo = JsonSerializer.Deserialize<RoomInfo>(json);
+            return roomInfo != null;
+        }
+        catch
+        {
+            return false;
+        }
+    }
+
+    private string GetDeviceName()
+    {
+        try
+        {
+            var build = Java.Lang.Class.ForName("android.os.Build");
+            var modelField = build.GetField("MODEL");
+            var model = modelField.Get(null)?.ToString() ?? "Android";
+            return model;
+        }
+        catch
+        {
+            return "Android Device";
+        }
+    }
+
+    private string GetPrimaryLocalIpAddress()
+    {
+        try
+        {
+            var addresses = LanMultiplayerPatches.GetLocalIpv4Addresses();
+            return addresses.FirstOrDefault() ?? "127.0.0.1";
+        }
+        catch
+        {
+            return "127.0.0.1";
+        }
+    }
+
+    private bool IsLocalAddress(string ipAddress)
+    {
+        try
+        {
+            var addresses = LanMultiplayerPatches.GetLocalIpv4Addresses();
+            return addresses.Contains(ipAddress);
+        }
+        catch
+        {
+            return false;
+        }
+    }
+
+    private void AcquireMulticastLock()
+    {
+        try
+        {
+            var context = Android.App.Application.Context;
+            var wifiManager = context.GetSystemService(Android.Content.Context.WifiService) as Android.Net.Wifi.WifiManager;
+            if (wifiManager != null)
+            {
+                _multicastLock = wifiManager.CreateMulticastLock("sts2_lan_discovery");
+                if (_multicastLock != null)
+                {
+                    var method = _multicastLock.GetType().GetMethod("acquire", new Type[0]);
+                    method?.Invoke(_multicastLock, null);
+                    PatchHelper.Log("LAN discovery: Acquired multicast lock");
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Failed to acquire multicast lock: {ex.Message}");
+        }
+    }
+
+    private void ReleaseMulticastLock()
+    {
+        try
+        {
+            if (_multicastLock != null)
+            {
+                var method = _multicastLock.GetType().GetMethod("release", new Type[0]);
+                method?.Invoke(_multicastLock, null);
+                _multicastLock = null;
+                PatchHelper.Log("LAN discovery: Released multicast lock");
+            }
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Failed to release multicast lock: {ex.Message}");
+        }
+    }
+}
