+    private static void StartRoomDiscovery(NJoinFriendScreen screen)
+    {
+        try
+        {
+            if (!AndroidSettingsBridge.GetBool("lan_room_discovery_enabled", true))
+            {
+                PatchHelper.Log("LAN room discovery disabled in settings");
+                return;
+            }
+
+            StopRoomDiscovery();
+            _discoveryService = new LanRoomDiscoveryService();
+            _discoveryService.StartListening();
+            
+            // Start periodic UI refresh
+            TaskHelper.RunSafely(RefreshDiscoveredRoomsLoop(screen));
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Failed to start room discovery: {ex}");
+        }
+    }
+
+    private static void StopRoomDiscovery()
+    {
+        try
+        {
+            _discoveryService?.Dispose();
+            _discoveryService = null;
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Error stopping room discovery: {ex}");
+        }
+    }
+
+    private static async Task RefreshDiscoveredRoomsLoop(NJoinFriendScreen screen)
+    {
+        try
+        {
+            while (_discoveryService != null && Node.IsInstanceValid(screen) && screen.Visible)
+            {
+                UpdateDiscoveredRoomsList(screen);
+                await Task.Delay(1000);
+            }
+        }
+        catch
+        {
+            // Screen was disposed or task was cancelled
+        }
+    }
+
+    private static void UpdateDiscoveredRoomsList(NJoinFriendScreen screen)
+    {
+        try
+        {
+            if (_discoveryService == null)
+                return;
+
+            var panel = screen.GetNode<Control>("Panel");
+            var container = panel.GetNodeOrNull<VBoxContainer>("LanJoinContainer");
+            if (container == null)
+                return;
+
+            var roomListContainer = container.GetNodeOrNull<VBoxContainer>("DiscoveredRoomsList");
+            if (roomListContainer == null)
+                return;
+
+            // Clear existing room buttons
+            foreach (var child in roomListContainer.GetChildren())
+            {
+                if (child is Button)
+                    child.QueueFree();
+            }
+
+            var rooms = _discoveryService.GetDiscoveredRooms();
+            if (rooms.Count == 0)
+            {
+                var noRoomsLabel = roomListContainer.GetNodeOrNull<Label>("NoRoomsLabel");
+                if (noRoomsLabel == null)
+                {
+                    noRoomsLabel = new Label
+                    {
+                        Name = "NoRoomsLabel",
+                        Text = T("正在搜索局域网房间...", "Searching for LAN rooms..."),
+                        HorizontalAlignment = HorizontalAlignment.Center
+                    };
+                    noRoomsLabel.AddThemeColorOverride("font_color", new Color(0.7f, 0.7f, 0.7f));
+                    noRoomsLabel.AddThemeFontSizeOverride("font_size", 20);
+                    roomListContainer.AddChild(noRoomsLabel);
+                }
+            }
+            else
+            {
+                roomListContainer.GetNodeOrNull<Label>("NoRoomsLabel")?.QueueFree();
+
+                foreach (var room in rooms)
+                {
+                    var button = CreateRoomButton(screen, room);
+                    roomListContainer.AddChild(button);
+                }
+            }
+        }
+        catch (Exception ex)
+        {
+            PatchHelper.Log($"Error updating discovered rooms list: {ex}");
+        }
+    }
+
+    private static Button CreateRoomButton(NJoinFriendScreen screen, LanRoomDiscoveryService.RoomInfo room)
+    {
+        var button = new Button
+        {
+            CustomMinimumSize = new Vector2(0, 60),
+            SizeFlagsHorizontal = Control.SizeFlags.ExpandFill
+        };
+
+        var playerInfo = $"{room.CurrentPlayers}/{room.MaxPlayers}";
+        var buttonText = $"{room.HostName} ({room.GameMode}) - {playerInfo}\n{room.HostIpAddress}:{room.GamePort}";
+        button.Text = buttonText;
+        button.AddThemeFontSizeOverride("font_size", 20);
+
+        button.Connect(Button.SignalName.Pressed, Callable.From(() =>
+        {
+            try
+            {
+                if (TryGetLanInputs(screen, out var hostInput, out var portInput))
+                {
+                    hostInput.Text = room.HostIpAddress;
+                    portInput.Text = room.GamePort.ToString();
+                }
+            }
+            catch (Exception ex)
+            {
+                PatchHelper.Log($"Error selecting discovered room: {ex}");
+            }
+        }));
+
+        return button;
+    }
+
+    private static void StartHostBroadcast(ushort port, int currentPlayers, int maxPlayers, string gameMode)
+    {
+        try
+        {
+            if (!AndroidSettingsBridge.GetBool("lan_room_discovery_enabled", true))
